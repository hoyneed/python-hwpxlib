    "import requests\n",
    "\n",
    "url = \"http://localhost:7860/extract-text\"\n",
    "file_path = \"2025년 행정안전부 업무계획.hwpx\"\n",
    "\n",
    "with open(file_path, 'rb') as f:\n",
    "    files = {'file': (file_path, f)}\n",
    "    response = requests.post(url, files=files)\n",
    "\n",
    "print(response.json())"
   ],
